  {
    "id": "template_event_rsvp",
    "name": "Event RSVP",
    "category": "event",
    "description": "Track attendance, guest count, and meal preferences for an upcoming event.",
    "isBlank": false,
    "gradient": "from-emerald-500 to-teal-500",
