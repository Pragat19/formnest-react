[
  {
    "id": "template_edu_student_details",
    "name": "Student Details",
    "category": "education",
    "description": "Standard template to collect comprehensive student details including personal and academic information.",
    "isBlank": false,
    "gradient": "from-blue-500 to-indigo-500",
    "formSettings": {
      "isPublic": true,
      "allowMultipleSubmissions": false
    },
    "schema": [
      {
        "id": "field_name",
        "type": "short_answer",
        "label": "Student Name",
        "required": true,
        "placeholder": "Enter full name"
      },
      {
        "id": "field_enrollment",
        "type": "number",
        "label": "Enrollment No.",
        "required": true,
        "placeholder": "e.g., 2023000123"
      },
      {
        "id": "field_email",
        "type": "email",
        "label": "Email Address",
        "required": true,
        "placeholder": "student@university.edu"
      },
      {
        "id": "field_phone",
        "type": "short_answer",
        "label": "Phone Number",
        "required": true,
        "placeholder": "+1 234 567 8900"
      },
      {
        "id": "field_gender",
        "type": "dropdown",
        "label": "Gender",
        "required": true,
        "options": [
          "Male",
          "Female",
          "Non-binary",
          "Prefer not to say"
        ]
      },
      {
        "id": "field_department",
        "type": "multiple_choice",
        "label": "Department",
        "required": true,
        "options": [
          "Computer Science",
          "Information Technology",
          "Mechanical Engineering",
          "Electrical Engineering",
          "Civil Engineering",
          "Business Administration",
          "Arts & Humanities"
        ]
      },
      {
        "id": "field_semester",
        "type": "dropdown",
        "label": "Semester",
        "required": true,
        "options": [
          "Semester 1",
          "Semester 2",
          "Semester 3",
          "Semester 4",
          "Semester 5",
          "Semester 6",
          "Semester 7",
          "Semester 8"
        ]
      },
      {
        "id": "field_admission_date",
        "type": "date",
        "label": "Date of Admission",
        "required": false
      },
      {
        "id": "field_id_upload",
        "type": "file_upload",
        "label": "Upload Student ID Card",
        "required": false,
        "allowedExtensions": [".pdf", ".jpg", ".png"]
      },
      {
        "id": "field_interests",
        "type": "checkboxes",
        "label": "Extracurricular Interests",
        "required": false,
        "options": [
          "Sports & Athletics",
          "Music & Arts",
          "Debate Club",
          "Coding & Tech Club",
          "Student Council"
        ]
      },
      {
        "id": "field_enthusiasm_rating",
        "type": "rating",
        "label": "How excited are you for this academic year?",
        "required": false,
        "maxRating": 5
      },
      {
        "id": "field_additional_notes",
        "type": "long_answer",
        "label": "Additional Notes / Special Accommodations",
        "required": false,
        "placeholder": "Please list any special requirements, allergies, or other notes here..."
      }
    ]
  },
  {
    "id": "template_edu_university_quiz",
        "name": "University Quiz",
        "category": "education",
        "description": "A simple, editable quiz template for university courses. Add your course questions and answer choices, then share it with students.",
        "isBlank": false,
        "gradient": "from-orange-500 to-amber-500",
        "formSettings": {
          "isPublic": true,
          "allowMultipleSubmissions": false
        },
        "settings": {
          "isQuiz": true
        },
        "schema": [
          {
            "id": "field_student_name",
            "type": "short_answer",
            "label": "Student Name",
            "required": true,
            "placeholder": "Enter your full name"
          },
          {
            "id": "field_student_id",
            "type": "short_answer",
            "label": "Student ID",
            "required": true,
            "placeholder": "Enter your university student ID"
          },
          {
            "id": "field_course",
            "type": "short_answer",
            "label": "Course / Subject",
            "required": true,
            "placeholder": "e.g., Introduction to Biology"
          },
          {
            "id": "field_semester",
            "type": "dropdown",
            "label": "Semester",
            "required": true,
            "options": [
              "Semester 1",
              "Semester 2",
              "Semester 3",
              "Semester 4",
              "Semester 5",
              "Semester 6",
              "Semester 7",
              "Semester 8"
            ]
          },
          {
            "id": "field_question_1",
            "type": "multiple_choice",
            "label": "Question 1: What is the main topic covered in this course?",
            "required": true,
            "options": [
              "Replace with answer option 1",
              "Replace with answer option 2",
              "Replace with answer option 3",
              "Replace with answer option 4"
            ]
          },
          {
            "id": "field_question_2",
            "type": "multiple_choice",
            "label": "Question 2: Which concept best describes a key idea from the course?",
            "required": true,
            "options": [
              "Replace with answer option 1",
              "Replace with answer option 2",
              "Replace with answer option 3",
              "Replace with answer option 4"
            ]
          },
          {
            "id": "field_question_3",
            "type": "multiple_choice",
            "label": "Question 3: Which example applies the course material correctly?",
            "required": true,
            "options": [
              "Replace with answer option 1",
              "Replace with answer option 2",
              "Replace with answer option 3",
              "Replace with answer option 4"
            ]
          },
          {
            "id": "field_question_4",
            "type": "multiple_choice",
            "label": "Question 4: Which statement about the course material is accurate?",
            "required": true,
            "options": [
              "Replace with answer option 1",
              "Replace with answer option 2",
              "Replace with answer option 3",
              "Replace with answer option 4"
            ]
          },
          {
            "id": "field_additional_comments",
            "type": "long_answer",
            "label": "Additional Comments",
            "required": false,
            "placeholder": "Optional feedback for your instructor"
          }
        ]
      },
      {
        "id": "template_edu_faculty_feedback",
    "name": "Faculty Feedback Form",
    "category": "education",
    "description": "A comprehensive faculty evaluation form for students to rate teaching quality, course content, and overall experience using grid-based multiple choice questions.",
    "isBlank": false,
    "gradient": "from-violet-500 to-purple-600",
    "formSettings": {
      "isPublic": true,
      "allowMultipleSubmissions": false
    },
    "schema": [
      {
        "id": "field_student_name",
        "type": "short_answer",
        "label": "Student Name",
        "required": false,
        "placeholder": "Enter your name (optional)"
      },
      {
        "id": "field_faculty_name",
        "type": "short_answer",
        "label": "Faculty Name",
        "required": true,
        "placeholder": "Enter faculty member's name"
      },
      {
        "id": "field_course",
        "type": "short_answer",
        "label": "Course / Subject",
        "required": true,
        "placeholder": "e.g., Data Structures & Algorithms"
      },
      {
        "id": "field_semester",
        "type": "dropdown",
        "label": "Semester",
        "required": true,
        "options": ["Semester 1", "Semester 2", "Semester 3", "Semester 4", "Semester 5", "Semester 6", "Semester 7", "Semester 8"]
      },
      {
        "id": "field_teaching_quality_grid",
        "type": "multiple_choice_grid",
        "label": "Teaching Quality Evaluation",
        "required": true,
        "helpText": "Please rate the following aspects of teaching quality (select one per row).",
        "rows": [
          "Clarity of explanations",
          "Use of real-world examples",
          "Pace of teaching",
          "Ability to answer questions",
          "Student engagement"
        ],
        "columns": ["Poor", "Fair", "Good", "Very Good", "Excellent"]
      },
      {
        "id": "field_course_content_grid",
        "type": "multiple_choice_grid",
        "label": "Course Content & Materials",
        "required": true,
        "helpText": "Rate the following aspects related to the course content (select one per row).",
        "rows": [
          "Relevance of syllabus",
          "Quality of study materials",
          "Difficulty level",
          "Coverage of topics"
        ],
        "columns": ["Strongly Disagree", "Disagree", "Neutral", "Agree", "Strongly Agree"]
      },
      {
        "id": "field_interaction_grid",
        "type": "tick_box_grid",
        "label": "Faculty Interaction & Support",
        "required": false,
        "helpText": "Check all that apply for each interaction area.",
        "rows": [
          "Accessible during office hours",
          "Responds to emails promptly",
          "Provides helpful feedback on assignments",
          "Encourages questions in class"
        ],
        "columns": ["Always", "Often", "Sometimes", "Rarely"]
      },
      {
        "id": "field_assessment_grid",
        "type": "multiple_choice_grid",
        "label": "Assessment & Grading",
        "required": true,
        "helpText": "Rate the following aspects of assessments and grading (select one per row).",
        "rows": [
          "Fairness of exams/assignments",
          "Timely return of graded work",
          "Clarity of grading criteria"
        ],
        "columns": ["Very Poor", "Poor", "Average", "Good", "Excellent"]
      },
      {
        "id": "field_overall_rating",
        "type": "rating",
        "label": "Overall Faculty Rating",
        "required": true,
        "maxRating": 5
      },
      {
        "id": "field_suggestions",
        "type": "long_answer",
        "label": "Suggestions for Improvement",
        "required": false,
        "placeholder": "Share any suggestions to help the faculty improve the course or teaching style..."
      }
    ]
  },
