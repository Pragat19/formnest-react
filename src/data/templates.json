  {
    "id": "template_personal_goal_planner",
    "name": "Personal Goal Planner",
    "category": "personal",
    "description": "Plan a personal goal by capturing its category, target date, priorities, and next steps.",
    "isBlank": false,
    "gradient": "from-violet-500 to-purple-500",
    "formSettings": {
      "isPublic": true,
      "allowMultipleSubmissions": false
    },
    "schema": [
      {
        "id": "field_goal_name",
        "type": "short_answer",
        "label": "What is your goal?",
        "required": true,
        "placeholder": "e.g., Build a regular exercise habit"
      },
      {
        "id": "field_goal_category",
        "type": "dropdown",
        "label": "Goal Category",
        "required": true,
        "options": ["Health", "Learning", "Career", "Finance", "Relationships", "Other"]
      },
      {
        "id": "field_goal_target_date",
        "type": "date",
        "label": "Target Date",
        "required": false
      },
      {
        "id": "field_goal_priority",
        "type": "multiple_choice",
        "label": "How important is this goal to you?",
        "required": true,
        "options": ["High", "Medium", "Low"]
      },
      {
        "id": "field_goal_steps",
        "type": "long_answer",
        "label": "What steps will help you reach this goal?",
        "required": true,
        "placeholder": "List your first steps and any support you may need"
      }
    ]
  },
